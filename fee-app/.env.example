# Google service account that is shared on the fee spreadsheet as Editor.
# Create it in a dedicated Google Cloud project with ONLY the Sheets API enabled.
# See docs/SETUP.md for the step-by-step.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key from the service-account JSON, newlines kept as \n,
# wrapped in double quotes. Example:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# The spreadsheet id from its URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
FEES_SHEET_ID=

# Signs the session cookie. Generate with: openssl rand -base64 48
# Changing this signs every user out, which is the intended way to kill all sessions.
SESSION_SECRET=

# Optional. Seconds to cache sheet reads inside a single function instance.
# Defaults to 30. Set to 0 while debugging data problems.
SHEET_CACHE_TTL_SECONDS=30
